generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ORGANIZER
  CHECK_IN_STAFF
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  events       Event[]
  refreshTokens RefreshToken[]
  registrationsCreated Registration[]
  assignedToSessions SessionStaff[] @relation("assignedTo")
  assignedStaff      SessionStaff[] @relation("assignedBy")
  auditLogsPerformed AuditLog[]     @relation("performedBy")
  alertsDismissed    CapacityAlert[] @relation("dismissedBy")

  @@map("users")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  venue       String
  startDate   DateTime
  endDate     DateTime
  isArchived  Boolean  @default(false)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]

  @@map("events")
}

model Session {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @db.Uuid
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  startTime   DateTime
  durationMin Int
  location    String
  capacity    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  registrations Registration[]
  staff       SessionStaff[]
  capacityAlert CapacityAlert?

  @@index([eventId])
  @@index([startTime])
  @@map("sessions")
}

model Registration {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @db.Uuid
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendeeName   String
  attendeeEmail  String
  status         String    @default("reserved")
  reservedAt     DateTime  @default(now())
  confirmedAt    DateTime?
  checkedInAt    DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  createdById    String?   @db.Uuid
  createdBy      User?     @relation(fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  auditLogs      AuditLog[]

  @@index([sessionId])
  @@index([status])
  @@index([attendeeEmail])
  @@index([reservedAt])
  @@map("registrations")
}

model SessionStaff {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  userId      String   @db.Uuid
  assignedById String  @db.Uuid
  assignedAt  DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User     @relation(name: "assignedTo", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User     @relation(name: "assignedBy", fields: [assignedById], references: [id])

  @@unique([sessionId, userId])
  @@map("session_staff")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  action         String       @db.VarChar(50)
  oldStatus      String?      @db.VarChar(20)
  newStatus      String?      @db.VarChar(20)
  note           String?      @db.Text
  performedById  String?      @db.Uuid
  performedAt    DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  performedBy    User?        @relation(name: "performedBy", fields: [performedById], references: [id])

  @@index([registrationId])
  @@index([performedAt])
  @@map("audit_log")
}

model CapacityAlert {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @unique @db.Uuid
  isDismissed  Boolean   @default(false)
  dismissedById String?  @db.Uuid
  dismissedAt  DateTime?
  triggeredAt  DateTime  @default(now())

  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dismissedBy  User?     @relation(name: "dismissedBy", fields: [dismissedById], references: [id])

  @@index([isDismissed])
  @@map("capacity_alerts")
}
